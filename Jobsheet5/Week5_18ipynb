host:8080/"},"id":"85d86e03","executionInfo":{"status":"ok","timestamp":1790060103422,"user_tz":-420,"elapsed":237,"user":{"displayName":"Eril Ocshada","userId":"12194638544303868802"}},"outputId":"ec62a64f-ff6b-4657-ce7c-44849a7736f1"},"source":["import matplotlib.pyplot as plt\n","import numpy as np\n","import cv2 as cv\n","import os\n","\n","# Prepare to store processed data\n","images_gray = {}\n","normalized_hists = {}\n","cdfs = {}\n","\n","# Load KTM images\n","base_path = '/content/drive/MyDrive/PCVK/Images/244107020064/'\n","ktm_image_files = ['KTM1a.jpg', 'KTM1b.jpg', 'KTM1c.jpg', 'KTM1d.jpg']\n","ktm_images = {}\n","for f in ktm_image_files:\n","    path = os.path.join(base_path, f)\n","    img = cv.imread(path)\n","    if img is None:\n","        print(f\"Warning: Could not load image {f} from {path}. Skipping.\")\n","        continue\n","    ktm_images[f] = img\n","\n","for name, img_data in ktm_images.items():\n","    if img_data is None:\n","        print(f\"Skipping processing for {name} due to loading error.\")\n","        continue\n","\n","    # Check number of channels in the image\n","    if img_data.ndim == 3 and img_data.shape[2] == 3: # If it's a 3-channel BGR image\n","        gray_img = cv.cvtColor(img_data, cv.COLOR_BGR2GRAY)\n","    elif img_data.ndim == 2: # If it's already a grayscale image (2 dimensions)\n","        gray_img = img_data\n","    else:\n","        print(f\"Warning: Image {name} has an unexpected number of channels/dimensions ({img_data.ndim}). Skipping.\")\n","        continue\n","\n","    images_gray[name] = gray_img\n","\n","    # Calculate histogram\n","    hist = cv.calcHist([gray_img], [0], None, [256], [0, 256])\n","\n","    # Normalize histogram\n","    normalized_hist = hist / (gray_img.shape[0] * gray_img.shape[1])\n","    normalized_hists[name] = normalized_hist\n","\n","    # Calculate CDF (Cumulative Distribution Function)\n","    cdf = normalized_hist.cumsum()\n","    cdfs[name] = cdf\n","\n","print(\"Histograms and CDFs calculated for all KTM images.\")\n"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Histograms and CDFs calculated for all KTM images.\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":558},"id":"abdea526","executionInfo":{"status":"ok","timestamp":1790060149614,"user_tz":-420,"elapsed":680,"user":{"displayName":"Eril Ocshada","userId":"12194638544303868802"}},"outputId":"9187dffa-b292-456b-b8fa-99e7c25a2d48"},"source":["fig, axes = plt.subplots(2, 2, figsize=(15, 12))\n","fig.suptitle('Normalized Histograms and CDFs for KTM Images', fontsize=16)\n","\n","# Flatten axes for easy iteration\n","axes = axes.flatten()\n","\n","image_names_sorted = sorted(ktm_images.keys()) # Sort names for consistent order\n","\n","for i, name in enumerate(image_names_sorted):\n","    ax = axes[i]\n","\n","    # Plot Normalized Histogram\n","    ax.plot(normalized_hists[name], color='gray', label='Normalized Histogram')\n","\n","    # Plot CDF\n","    ax.plot(cdfs[name], color='blue', label='CDF')\n","\n","    ax.set_title(f'Image: {name}', fontsize=12)\n","    ax.set_xlabel('Pixel Intensity', fontsize=10)\n","    ax.set_ylabel('Probability / Cumulative Probability', fontsize=10)\n","    ax.legend()\n","    ax.grid(True, linestyle='--', alpha=0.6)\n","    ax.set_xlim([0, 255])\n","    ax.set_ylim([0, 1])\n","\n","plt.tight_layout(rect=[0, 0.03, 1, 0.96]) # Adjust layout to prevent title overlap\n","plt.show()"],"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x1200 with 4 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"bb4c0255"},"source":["### Penjelasan Perbedaan Kurva CDF\n","\n","Berdasarkan plot di atas dan nilai kecerahan rata-rata (`image_brightness`) yang telah dihitung sebelumnya:\n","\n","*   **Gambar paling gelap (`KTM1a.jpg`)**: Kurva CDF-nya cenderung naik dengan cepat di awal (intensitas pixel rendah) dan kemudian mendatar. Ini menunjukkan bahwa sebagian besar piksel dalam gambar memiliki nilai intensitas yang rendah (gelap). Kenaikan yang curam di bagian awal mengindikasikan bahwa banyak piksel terkonsentrasi pada rentang gelap, dan mencapai nilai kumulatif 1 (atau mendekati 1) jauh sebelum mencapai intensitas piksel maksimum (255).\n","\n","*   **Gambar paling terang (`KTM1b.jpg`)**: Sebaliknya, kurva CDF untuk gambar ini akan menunjukkan kenaikan yang lebih lambat di awal dan akan mulai menanjak tajam pada intensitas piksel yang lebih tinggi. Ini mengindikasikan bahwa distribusi piksel didominasi oleh nilai intensitas yang tinggi (cerah), dan kurva membutuhkan waktu lebih lama untuk mencapai nilai kumulatif 1 karena piksel-pikselnya tersebar di rentang yang lebih cerah.\n","\n","**Kaitan dengan Kondisi Pencahayaan saat Akuisisi:**\n","\n","*   **Citra paling gelap (`KTM1a.jpg`)** memiliki kurva CDF yang bergeser ke kiri, menandakan mayoritas pikselnya gelap. Ini kemungkinan besar disebabkan oleh kondisi pencahayaan yang **kurang memadai atau redup** saat gambar diambil. Objek dalam citra mungkin kurang terpapar cahaya, sehingga menghasilkan detail yang tersembunyi di area bayangan dan kontras yang rendah.\n","\n","*   **Citra paling terang (`KTM1b.jpg`)** memiliki kurva CDF yang bergeser ke kanan, menandakan mayoritas pikselnya cerah. Ini menunjukkan bahwa gambar diambil dalam kondisi pencahayaan yang **sangat terang atau berlimpah**. Hal ini bisa menyebabkan beberapa area terang menjadi 'overexposed' (terlalu cerah) sehingga kehilangan detail, atau secara umum, citra memiliki distribusi warna yang cenderung ke arah putih/terang."]},{"cell_type":"markdown","metadata":{"id":"9c6073fa"},"source":["## **Jawaban Praktikum E1 - Soal 3: Perbandingan Histogram dengan Jumlah Bin Berbeda**"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":244},"id":"3f160df5","executionInfo":{"status":"ok","timestamp":1790060392915,"user_tz":-420,"elapsed":978,"user":{"displayName":"Eril Ocshada","userId":"12194638544303868802"}},"outputId":"bae311f8-f7bc-4c18-c462-8b864555e0dd"},"source":["import matplotlib.pyplot as plt\n","import numpy as np\n","import cv2 as cv\n","\n","# Ensure PARAM dictionary is defined. If not, define it for this example.\n","if 'PARAM' not in locals():\n","    PARAM = {'bins': 64} # Default value if not already set\n","\n","# Assuming ktm_images and images_gray are available from previous cells\n","image_name = 'KTM1b.jpg'\n","\n","# Get the grayscale image for KTM1b.jpg\n","if image_name in images_gray:\n","    ktm1b_gray = images_gray[image_name]\n","else:\n","    # Fallback if images_gray wasn't populated or KTM1b.jpg was skipped\n","    print(f\"Reloading {image_name} for processing.\")\n","    base_path = '/content/drive/MyDrive/PCVK/Images/244107020064/'\n","    ktm1b_bgr = cv.imread(os.path.join(base_path, image_name))\n","    if ktm1b_bgr is not None:\n","        ktm1b_gray = cv.cvtColor(ktm1b_bgr, cv.COLOR_BGR2GRAY)\n","    else:\n","        print(f\"Error: Could not load {image_name}. Skipping histogram comparison.\")\n","        ktm1b_gray = None\n","\n","if ktm1b_gray is not None:\n","    # Histogram with 256 bins\n","    hist_256_bins = cv.calcHist([ktm1b_gray], [0], None, [256], [0, 256]).flatten()\n","\n","    # Histogram with PARAM['bins'] bins\n","    num_bins_param = PARAM['bins']\n","    hist_param_bins = cv.calcHist([ktm1b_gray], [0], None, [num_bins_param], [0, 256]).flatten()\n","\n","    # Create bin edges and centers for plotting\n","    bin_edges_256 = np.arange(257)\n","    bin_centers_256 = (bin_edges_256[:-1] + bin_edges_256[1:]) / 2\n","\n","    bin_edges_param = np.linspace(0, 256, num_bins_param + 1)\n","    bin_centers_param = (bin_edges_param[:-1] + bin_edges_param[1:]) / 2\n","\n","    # Plotting\n","    fig, axs = plt.subplots(1, 2, figsize=(15, 5), sharey=True)\n","    fig.suptitle(f'Histogram Comparison for {image_name}', fontsize=16)\n","\n","    # Plot 256 bins histogram\n","    axs[0].bar(bin_centers_256, hist_256_bins, width=1, color='gray')\n","    axs[0].set_title(f'Histogram with 256 Bins')\n","    axs[0].set_xlabel('Pixel Intensity')\n","    axs[0].set_ylabel('Frequency')\n","    axs[0].set_xlim([0, 255])\n","    axs[0].grid(True, linestyle='--', alpha=0.7)\n","\n","    # Plot PARAM['bins'] bins histogram\n","    # Adjust bar width to match bin size visually\n","    bar_width_param = 256 / num_bins_param\n","    axs[1].bar(bin_centers_param, hist_param_bins, width=bar_width_param * 0.9, color='blue', alpha=0.7)\n","    axs[1].set_title(f'Histogram with {num_bins_param} Bins (PARAM[\"bins\"])')\n","    axs[1].set_xlabel('Pixel Intensity')\n","    axs[1].set_ylabel('Frequency')\n","    axs[1].set_xlim([0, 255])\n","    axs[1].grid(True, linestyle='--', alpha=0.7)\n","\n","    plt.tight_layout(rect=[0, 0.03, 1, 0.95])\n","    plt.show()\n","else:\n","    print(\"Cannot plot histograms as KTM1b.jpg data is not available.\")\n"],"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x500 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"16e70ed2"},"source":["### Penjelasan Informasi yang Hilang dengan Pengurangan Jumlah Bin\n","\n","Ketika jumlah bin pada histogram dikurangi dari 256 menjadi `PARAM['bins']` (misalnya 64), informasi yang hilang adalah **detail distribusi intensitas piksel**.\n","\n","*   **Dengan 256 bin**: Setiap bin merepresentasikan satu nilai intensitas piksel (0-255). Ini memberikan gambaran yang sangat granular dan akurat tentang berapa kali setiap nilai intensitas muncul dalam citra. Kurva histogram akan menampilkan \"puncak\" dan \"lembah\" kecil yang mencerminkan variasi halus dalam distribusi intensitas.\n","\n","*   **Dengan jumlah bin yang lebih sedikit (misalnya 64 bin)**: Setiap bin sekarang merepresentasikan rentang nilai intensitas yang lebih lebar (misalnya, untuk 64 bin, setiap bin mencakup 4 nilai intensitas, 256/64 = 4). Frekuensi piksel dari seluruh rentang ini dikelompokkan menjadi satu bin. Akibatnya:\n","    *   **Kehilangan Detail Halus**: Variasi kecil dan puncak-puncak sempit pada distribusi intensitas akan \"diratakan\" atau digabungkan. Anda mungkin kehilangan kemampuan untuk membedakan antara dua kelompok piksel yang memiliki intensitas sangat dekat tetapi berada di bin yang berbeda pada histogram 256 bin.\n","    *   **Generalisasi Distribusi**: Histogram menjadi lebih umum dan \"halus\". Ini bisa membantu dalam melihat tren distribusi yang lebih besar dan mengurangi \"noise\" visual, namun mengorbankan keakuratan representasi frekuensi setiap nilai piksel individu.\n","    *   **Resolusi Kuantisasi Berkurang**: Gambar asli memiliki 256 tingkat keabuan, tetapi histogram dengan bin yang lebih sedikit secara efektif \"menguantisasi\" ulang intensitas menjadi lebih sedikit tingkat. Ini seperti mengurangi jumlah warna yang tersedia dalam palet, yang membuat gradasi terlihat kurang mulus.\n","\n","Secara sederhana, mengurangi jumlah bin seperti memperbesar piksel pada sebuah gambar. Anda masih bisa melihat bentuk umumnya, tetapi detail-detail halus dan perbedaan kecil yang penting akan hilang."]},{"cell_type":"markdown","source":["# **E-2 PERCOBAAN HISTOGRAM EQUALIZATION **\n"],"metadata":{"id":"OSCNt9tX86v0"}},{"cell_type":"markdown","metadata":{"id":"9be9195f"},"source":["## **Jawaban Praktikum E2 - Soal 1: Ekualisasi Global pada Citra KTM**"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":838},"id":"613432c7","executionInfo":{"status":"ok","timestamp":1790577525182,"user_tz":-420,"elapsed":6653,"user":{"displayName":"Eril Ocshada","userId":"12194638544303868802"}},"outputId":"1070a2c5-91af-4c85-aa43-07d27aab9ede"},"source":["import cv2 as cv\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import os\n","\n","# 1. Load KTM1a.jpg dan ubah ke grayscale\n","base_path = '/content/drive/MyDrive/PCVK/Images/244107020064/'\n","ktm1a_bgr = cv.imread(os.path.join(base_path, 'KTM1a.jpg'))\n","\n","if ktm1a_bgr is None:\n","    print(\"Error: Gagal memuat KTM1a.jpg. Pastikan path sudah benar.\")\n","else:\n","    ktm1a_gray = cv.cvtColor(ktm1a_bgr, cv.COLOR_BGR2GRAY)\n","\n","    # 2. Histogram Equalization Manual\n","    # Hitung histogram\n","    hist_manual, bins = np.histogram(ktm1a_gray.flatten(), 256, [0, 256])\n","    # Hitung Cumulative Distribution Function (CDF)\n","    cdf_manual = hist_manual.cumsum()\n","    # Normalisasi CDF ke rentang [0, 255]\n","    cdf_normalized = (cdf_manual - cdf_manual.min()) * 255 / (cdf_manual.max() - cdf_manual.min())\n","    cdf_normalized = cdf_normalized.astype('uint8')\n","    # Mapping nilai piksel asli menggunakan CDF ternormalisasi\n","    img_equalized_manual = cdf_normalized[ktm1a_gray]\n","\n","    # 3. Histogram Equalization Menggunakan OpenCV (cv.equalizeHist)\n","    img_equalized_cv = cv.equalizeHist(ktm1a_gray)\n","\n","    # 4. Hitung PSNR antara citra asli dan hasil ekualisasi\n","    def calculate_psnr(img1, img2):\n","        mse = np.mean((img1 - img2) ** 2)\n","        if mse == 0:\n","            return float('inf')\n","        max_pixel = 255.0\n","        psnr = 20 * np.log10(max_pixel / np.sqrt(mse))\n","        return psnr\n","\n","    psnr_manual = calculate_psnr(ktm1a_gray, img_equalized_manual)\n","    psnr_cv = calculate_psnr(ktm1a_gray, img_equalized_cv)\n","\n","    print(f\"PSNR (Asli vs Manual Equalization): {psnr_manual:.4f} dB\")\n","    print(f\"PSNR (Asli vs OpenCV Equalization): {psnr_cv:.4f} dB\")\n","\n","    # 5. Visualisasi Citra dan Histogram dalam Satu Layout\n","    fig, axs = plt.subplots(3, 2, figsize=(14, 18))\n","    fig.suptitle('Global Histogram Equalization - KTM1a.jpg', fontsize=16)\n","\n","    # Citra Asli\n","    axs[0, 0].imshow(ktm1a_gray, cmap='gray')\n","    axs[0, 0].set_title('Citra Asli (Grayscale)')\n","    axs[0, 0].axis('off')\n","    # Histogram Citra Asli\n","    axs[0, 1].hist(ktm1a_gray.flatten(), bins=256, range=[0, 256], color='gray')\n","    axs[0, 1].set_title('Histogram Citra Asli')\n","    axs[0, 1].grid(True, alpha=0.5)\n","\n","    # Hasil Ekualisasi Manual\n","    axs[1, 0].imshow(img_equalized_manual, cmap='gray')\n","    axs[1, 0].set_title('Hasil Ekualisasi Manual')\n","    axs[1, 0].axis('off')\n","    # Histogram Ekualisasi Manual\n","    axs[1, 1].hist(img_equalized_manual.flatten(), bins=256, range=[0, 256], color='blue', alpha=0.7)\n","    axs[1, 1].set_title('Histogram Ekualisasi Manual')\n","    axs[1, 1].grid(True, alpha=0.5)\n","\n","    # Hasil Ekualisasi OpenCV\n","    axs[2, 0].imshow(img_equalized_cv, cmap='gray')\n","    axs[2, 0].set_title('Hasil Ekualisasi OpenCV (cv.equalizeHist)')\n","    axs[2, 0].axis('off')\n","    # Histogram Ekualisasi OpenCV\n","    axs[2, 1].hist(img_equalized_cv.flatten(), bins=256, range=[0, 256], color='green', alpha=0.7)\n","    axs[2, 1].set_title('Histogram Ekualisasi OpenCV')\n","    axs[2, 1].grid(True, alpha=0.5)\n","\n","    plt.tight_layout(rect=[0, 0.03, 1, 0.95])\n","    plt.show()"],"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["PSNR (Asli vs Manual Equalization): 28.3759 dB\n","PSNR (Asli vs OpenCV Equalization): 28.4431 dB\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x1800 with 6 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"0c3805fa"},"source":["### **Analisis Hasil Soal 1 (PSNR & Keterbacaan)**\n","\n","* **Mengapa nilai PSNR turun padahal citra terlihat lebih jelas?**\n","  PSNR (*Peak Signal-to-Noise Ratio*) dihitung berdasarkan MSE (*Mean Squared Error*) yang mengukur perbedaan matematis nilai piksel demi piksel antara citra asli dan citra hasil olahan. Ketika kita melakukan *Histogram Equalization*, kontras citra ditingkatkan secara agresif dengan merenggangkan distribusi intensitas piksel yang menumpuk. Perenggangan ini menyebabkan pergeseran nilai piksel yang sangat masif dibanding aslinya (MSE meningkat tajam). Karena PSNR berbanding terbalik dengan MSE, pergeseran nilai ini secara matematis dianggap sebagai \"distorsi\" atau \"noise\" yang menurunkan nilai PSNR, meskipun secara visual fitur dan teks pada kartu (NIM dan Nama) menjadi jauh lebih jelas dan kontras bagi mata manusia.\n","\n","* **Apakah PSNR layak dipakai untuk menilai keterbacaan sebuah citra?**\n","  **Tidak layak.** PSNR murni merupakan metrik kualitas rekonstruksi matematis, bukan metrik persepsi visual manusia atau keterbacaan (*readability*). Citra yang sangat gelap mungkin memiliki nilai PSNR tinggi jika dibandingkan dengan versi aslinya yang sedikit berderau, namun informasinya tidak dapat dibaca oleh manusia. Sebaliknya, citra hasil ekualisasi memiliki PSNR rendah karena perbedaan nilai piksel yang besar, tetapi keterbacaan teksnya justru meningkat secara signifikan."]},{"cell_type":"markdown","metadata":{"id":"b855ea14"},"source":["## **Jawaban Praktikum E2 - Soal 2: Ekualisasi Lokal dengan CLAHE**"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":379},"id":"60dcae5b","executionInfo":{"status":"ok","timestamp":1790577596643,"user_tz":-420,"elapsed":5551,"user":{"displayName":"Eril Ocshada","userId":"12194638544303868802"}},"outputId":"4bb734b6-3cfe-4cc1-8226-3f78b577c2f0"},"source":["import cv2 as cv\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import os\n","\n","# Definisikan PARAM secara lokal agar aman jika sel identitas belum dieksekusi\n","# Berdasarkan NIM Anda 2141720000 -> N = 0\n","NIM = '2141720000'\n","N = int(NIM[-3:])\n","PARAM = {\n","    'bins' : 2 ** ((N % 4) + 3),\n","    'clip' : round(1.0 + (N % 5) * 0.5, 1),\n","    'tile' : (N % 4) + 2,\n","    'L'    : 2 ** ((N % 3) + 1),\n","}\n","\n","# 1. Pastikan citra KTM1a.jpg dalam format grayscale termuat\n","base_path = '/content/drive/MyDrive/PCVK/Images/244107020064/'\n","ktm1a_bgr = cv.imread(os.path.join(base_path, 'KTM1a.jpg'))\n","\n","if ktm1a_bgr is None:\n","    print(\"Error: Gagal memuat KTM1a.jpg.\")\n","else:\n","    ktm1a_gray = cv.cvtColor(ktm1a_bgr, cv.COLOR_BGR2GRAY)\n","\n","    # Ambil hasil ekualisasi global untuk perbandingan\n","    img_equalized_cv = cv.equalizeHist(ktm1a_gray)\n","\n","    # Ambil parameter dasar dari identitas\n","    clip_base = PARAM['clip'] # Nilai default dari NIM Anda (1.0)\n","    tile_base = PARAM['tile'] # Nilai default dari NIM Anda (2)\n","\n","    # 2. Terapkan CLAHE dengan parameter dasar\n","    clahe_base = cv.createCLAHE(clipLimit=clip_base, tileGridSize=(tile_base, tile_base))\n","    img_clahe_base = clahe_base.apply(ktm1a_gray)\n","\n","    # 3. Uji coba dengan 3 nilai clipLimit lain di sekitar PARAM['clip'] (misal: 1.5, 2.0, 2.5)\n","    clip_limits = [1.5, 2.0, 2.5]\n","    clahe_variants = []\n","    for clip in clip_limits:\n","        clahe_obj = cv.createCLAHE(clipLimit=clip, tileGridSize=(tile_base, tile_base))\n","        clahe_variants.append(clahe_obj.apply(ktm1a_gray))\n","\n","    # 4. Visualisasi Perbandingan\n","    fig, axs = plt.subplots(2, 3, figsize=(18, 12))\n","    fig.suptitle('Local Equalization dengan CLAHE - KTM1a.jpg', fontsize=16)\n","\n","    # Baris 1: Perbandingan Global vs CLAHE Utama\n","    axs[0, 0].imshow(ktm1a_gray, cmap='gray')\n","    axs[0, 0].set_title('Citra Asli (Grayscale)')\n","    axs[0, 0].axis('off')\n","\n","    axs[0, 1].imshow(img_equalized_cv, cmap='gray')\n","    axs[0, 1].set_title('Ekualisasi Global (OpenCV)')\n","    axs[0, 1].axis('off')\n","\n","    axs[0, 2].imshow(img_clahe_base, cmap='gray')\n","    axs[0, 2].set_title(f'CLAHE Utama (clip={clip_base}, tile={tile_base}x{tile_base})')\n","    axs[0, 2].axis('off')\n","\n","    # Baris 2: Variasi nilai clipLimit di sekitar PARAM['clip']\n","    axs[1, 0].imshow(clahe_variants[0], cmap='gray')\n","    axs[1, 0].set_title(f'CLAHE (clip={clip_limits[0]}, tile={tile_base}x{tile_base})')\n","    axs[1, 0].axis('off')\n","\n","    axs[1, 1].imshow(clahe_variants[1], cmap='gray')\n","    axs[1, 1].set_title(f'CLAHE (clip={clip_limits[1]}, tile={tile_base}x{tile_base})')\n","    axs[1, 1].axis('off')\n","\n","    axs[1, 2].imshow(clahe_variants[2], cmap='gray')\n","    axs[1, 2].set_title(f'CLAHE (clip={clip_limits[2]}, tile={tile_base}x{tile_base})')\n","    axs[1, 2].axis('off')\n","\n","    plt.tight_layout(rect=[0, 0.03, 1, 0.95])\n","    plt.show()"],"execution_count":6,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x1200 with 6 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"7cee8ee1"},"source":["### **Analisis Hasil Soal 2 (CLAHE & Parameter Optimal)**\n","\n","* **Perbandingan CLAHE Utama (Global vs Lokal):**\n","  * Pada hasil **Ekualisasi Global**, kontras keseluruhan gambar ditarik secara merata. Hal ini membuat bagian latar belakang putih yang sudah terang menjadi sangat silau (*overexposed*), sementara bayangan gelap di area foto wajah dan teks di bawahnya masih kurang seimbang.\n","  * Pada hasil **CLAHE Lokal** (clip=1.0, tile=2x2), peningkatan kontras dilakukan pada ubin lokal (*tiles*). Hasilnya, pencahayaan menjadi jauh lebih merata ke seluruh bagian kartu. Bagian teks NIM dan Nama menjadi jauh lebih tajam dan mudah dibaca karena variasi kontras lokal terjaga dengan baik tanpa membuat area terang menjadi silau.\n","\n","* **Analisis Variasi `clipLimit` & Bagian yang Mengalami Noise:**\n","  * Ketika nilai `clipLimit` dinaikkan dari **1.0** ke **1.5**, **2.0**, hingga **2.5**, kontras lokal semakin tajam dan memperjelas tepian karakter teks.\n","  * Namun, seiring dengan kenaikan `clipLimit` tersebut, **noise (derau bintik-bintik abu-abu/hitam) mulai menonjol secara signifikan, terutama pada area bergradasi halus seperti latar belakang kartu KTM yang polos dan area foto wajah**.\n","  * **Kesimpulan Parameter Terbaik:** Nilai terbaik untuk citra KTM ini adalah `clipLimit` sebesar **1.5** atau **2.0** (tergantung ketajaman yang diinginkan) karena memberikan keseimbangan optimal antara keterbacaan karakter teks NIM/Nama yang tegas dengan tingkat noise latar belakang yang masih dalam batas wajar (tidak terlalu mengganggu mata)."]},{"cell_type":"markdown","metadata":{"id":"90436d53"},"source":["## **E-3 TUGAS PRAKTIKUM DITHERING**"]},{"cell_type":"markdown","metadata":{"id":"0c5ef116"},"source":["### **E-3 Soal 1: Implementasi Floyd-Steinberg Dithering**"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":367},"id":"678b5d2b","executionInfo":{"status":"ok","timestamp":1790577683079,"user_tz":-420,"elapsed":2617,"user":{"displayName":"Eril Ocshada","userId":"12194638544303868802"}},"outputId":"69cf5677-78fe-4fa7-a191-67ad49f85ee6"},"source":["import cv2 as cv\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import os\n","\n","def floyd_steinberg_dithering(image, levels):\n","    \"\"\"\n","    Fungsi untuk menerapkan dithering Floyd-Steinberg pada citra grayscale\n","    dengan jumlah tingkat keabuan (levels) tertentu.\n","    \"\"\"\n","    # Buat salinan citra bertipe float untuk mencegah overflow/underflow saat difusi error\n","    img = image.astype(float)\n","    h, w = img.shape\n","\n","    for y in range(h):\n","        for x in range(w):\n","            old_pixel = img[y, x]\n","            # Kuantisasi ke level terdekat\n","            new_pixel = np.round(old_pixel * (levels - 1) / 255.0) * (255.0 / (levels - 1))\n","            img[y, x] = new_pixel\n","\n","            # Hitung error\n","            err = old_pixel - new_pixel\n","\n","            # Difusi error ke tetangga sekitar sesuai matriks Floyd-Steinberg\n","            if x + 1 < w:\n","                img[y, x + 1] += err * 7 / 16\n","            if y + 1 < h:\n","                if x - 1 >= 0:\n","                    img[y + 1, x - 1] += err * 3 / 16\n","                img[y + 1, x] += err * 5 / 16\n","                if x + 1 < w:\n","                    img[y + 1, x + 1] += err * 1 / 16\n","\n","    return np.clip(img, 0, 255).astype(np.uint8)\n","\n","# --- TAHAP 1: Uji Coba pada lena.jpg (Grayscale) ---\n","lena_bgr = cv.imread('/content/drive/MyDrive/PCVK/Images/lena.jpg')\n","if lena_bgr is None:\n","    print(\"Error: Gagal memuat lena.jpg\")\n","else:\n","    lena_gray = cv.cvtColor(lena_bgr, cv.COLOR_BGR2GRAY)\n","    # Tahap 1 menggunakan biner (levels = 2)\n","    lena_dither = floyd_steinberg_dithering(lena_gray, levels=2)\n","\n","    # Tampilkan perbandingan\n","    fig, axs = plt.subplots(1, 2, figsize=(12, 6))\n","    axs[0].imshow(lena_gray, cmap='gray')\n","    axs[0].set_title('Citra Asli Lena (Grayscale)')\n","    axs[0].axis('off')\n","\n","    axs[1].imshow(lena_dither, cmap='gray')\n","    axs[1].set_title('Hasil Dithering Floyd-Steinberg (Levels=2)')\n","    axs[1].axis('off')\n","\n","    plt.suptitle('Uji Coba Tahap 1 - Lena.jpg', fontsize=16)\n","    plt.show()"],"execution_count":7,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":300},"id":"ca2f5ee8","executionInfo":{"status":"ok","timestamp":1790577698691,"user_tz":-420,"elapsed":15033,"user":{"displayName":"Eril Ocshada","userId":"12194638544303868802"}},"outputId":"a5bbb0c8-9a09-4e21-dba7-3ef213147737"},"source":["# --- TAHAP 2: Penerapan pada KTM1b.jpg dengan PARAM['L'] ---\n","base_path = '/content/drive/MyDrive/PCVK/Images/244107020064/'\n","ktm1b_bgr = cv.imread(os.path.join(base_path, 'KTM1b.jpg'))\n","\n","if ktm1b_bgr is None:\n","    print(\"Error: Gagal memuat KTM1b.jpg\")\n","else:\n","    ktm1b_gray = cv.cvtColor(ktm1b_bgr, cv.COLOR_BGR2GRAY)\n","    levels_L = PARAM['L']  # Nilai level berdasarkan NIM (2)\n","\n","    ktm1b_dither = floyd_steinberg_dithering(ktm1b_gray, levels=levels_L)\n","\n","    # Tampilkan perbandingan\n","    fig, axs = plt.subplots(1, 2, figsize=(15, 7))\n","    axs[0].imshow(ktm1b_gray, cmap='gray')\n","    axs[0].set_title('Citra Grayscale Asli (KTM1b.jpg)')\n","    axs[0].axis('off')\n","\n","    axs[1].imshow(ktm1b_dither, cmap='gray')\n","    axs[1].set_title(f'Hasil Dithering Floyd-Steinberg (Levels = {levels_L})')\n","    axs[1].axis('off')\n","\n","    plt.suptitle('Tahap 2 - Dithering KTM1b.jpg', fontsize=16)\n","    plt.show()"],"execution_count":8,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x700 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"2903c692"},"source":["### **E-3 Soal 2: Kombinasi Histogram Equalization dan Dithering Floyd-Steinberg**"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":249},"id":"e3b73f6c","executionInfo":{"status":"ok","timestamp":1790577747459,"user_tz":-420,"elapsed":5844,"user":{"displayName":"Eril Ocshada","userId":"12194638544303868802"}},"outputId":"ad140798-2591-4964-a6d6-fadbb2e88c60"},"source":["import cv2 as cv\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import os\n","\n","# --- TAHAP 1: Uji coba kombinasi pada lena_lc.jpg (Low Contrast) ---\n","lena_lc_bgr = cv.imread('/content/drive/MyDrive/PCVK/Images/lena_lc.jpg')\n","\n","if lena_lc_bgr is None:\n","    print(\"Error: Gagal memuat lena_lc.jpg. Pastikan file tersedia di folder Images.\")\n","else:\n","    lena_lc_gray = cv.cvtColor(lena_lc_bgr, cv.COLOR_BGR2GRAY)\n","\n","    # 1. Ekualisasi Histogram terlebih dahulu\n","    lena_lc_equalized = cv.equalizeHist(lena_lc_gray)\n","\n","    # 2. Terapkan Dithering Floyd-Steinberg pada citra asli (tanpa ekualisasi)\n","    lena_lc_dither_direct = floyd_steinberg_dithering(lena_lc_gray, levels=2)\n","\n","    # 3. Terapkan Dithering Floyd-Steinberg pada citra yang sudah diekualisasi\n","    lena_lc_dither_after_eq = floyd_steinberg_dithering(lena_lc_equalized, levels=2)\n","\n","    # Visualisasi perbandingan untuk lena_lc.jpg\n","    fig, axs = plt.subplots(1, 3, figsize=(18, 6))\n","    axs[0].imshow(lena_lc_gray, cmap='gray')\n","    axs[0].set_title('Lena Low Contrast Asli')\n","    axs[0].axis('off')\n","\n","    axs[1].imshow(lena_lc_dither_direct, cmap='gray')\n","    axs[1].set_title('Dithering Langsung (Tanpa EQ)')\n","    axs[1].axis('off')\n","\n","    axs[2].imshow(lena_lc_dither_after_eq, cmap='gray')\n","    axs[2].set_title('Dithering Setelah Ekualisasi')\n","    axs[2].axis('off')\n","\n","    plt.suptitle('Uji Coba Kombinasi - lena_lc.jpg', fontsize=16)\n","    plt.show()"],"execution_count":9,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x600 with 3 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":210},"id":"b2781f83","executionInfo":{"status":"ok","timestamp":1790577810946,"user_tz":-420,"elapsed":62885,"user":{"displayName":"Eril Ocshada","userId":"12194638544303868802"}},"outputId":"9a3d928c-a238-4a63-fac3-f2b1c6cd6ce6"},"source":["# --- TAHAP 2: Penerapan kombinasi pada KTM1a.jpg (Citra Gelap Anda) ---\n","base_path = '/content/drive/MyDrive/PCVK/Images/244107020064/'\n","ktm1a_bgr = cv.imread(os.path.join(base_path, 'KTM1a.jpg'))\n","\n","if ktm1a_bgr is None:\n","    print(\"Error: Gagal memuat KTM1a.jpg.\")\n","else:\n","    ktm1a_gray = cv.cvtColor(ktm1a_bgr, cv.COLOR_BGR2GRAY)\n","\n","    # 1. Ekualisasi Histogram\n","    ktm1a_equalized = cv.equalizeHist(ktm1a_gray)\n","\n","    # 2. Dithering langsung tanpa ekualisasi\n","    ktm1a_dither_direct = floyd_steinberg_dithering(ktm1a_gray, levels=2)\n","\n","    # 3. Dithering setelah ekualisasi\n","    ktm1a_dither_after_eq = floyd_steinberg_dithering(ktm1a_equalized, levels=2)\n","\n","    # Visualisasi perbandingan untuk KTM1a.jpg\n","    fig, axs = plt.subplots(1, 3, figsize=(18, 6))\n","    axs[0].imshow(ktm1a_gray, cmap='gray')\n","    axs[0].set_title('KTM1a.jpg Grayscale Asli')\n","    axs[0].axis('off')\n","\n","    axs[1].imshow(ktm1a_dither_direct, cmap='gray')\n","    axs[1].set_title('Dithering Langsung (Tanpa EQ)')\n","    axs[1].axis('off')\n","\n","    axs[2].imshow(ktm1a_dither_after_eq, cmap='gray')\n","    axs[2].set_title('Dithering Setelah Ekualisasi')\n","    axs[2].axis('off')\n","\n","    plt.suptitle('Kombinasi EQ & Dithering - KTM1a.jpg', fontsize=16)\n","    plt.show()"],"execution_count":10,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x600 with 3 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"b66ae18b"},"source":["### **Analisis Hasil Soal 2 (Pengaruh Urutan Ekualisasi terhadap Dithering)**\n","\n","* **Perbandingan Visual (Dithering Langsung vs Dithering Setelah Ekualisasi):**\n","  * **Dithering Langsung (Tanpa EQ)**: Karena citra asli `KTM1a.jpg` sangat gelap, proses kuantisasi langsung menjadi 2 level (hitam-putih) dominan menghasilkan bintik-bintik hitam pekat di hampir seluruh permukaan kartu. Informasi penting seperti teks Nama, NIM, logo Politeknik, serta foto wajah menjadi sangat samar dan hampir tidak terbaca sama sekali.\n","  * **Dithering Setelah Ekualisasi**: Melalui *Histogram Equalization* terlebih dahulu, sebaran kontras gelap-terang pada kartu diratakan sehingga detail yang awalnya tersembunyi di kegelapan dimunculkan secara optimal. Ketika dilanjutkan dengan dithering Floyd-Steinberg, persepsi gradasi bintik hitam-putih terbentuk secara proporsional.\n","\n","* **Urutan yang Menghasilkan Teks Paling Terbaca:**\n","  Urutan **Histogram Equalization -> Dithering** menghasilkan teks yang **jauh lebih terbaca**. Pada citra hasil urutan ini, karakter teks nama, NIM, serta detail struktural kartu tercetak dengan kontras tepi biner hitam-putih yang sangat tajam di atas latar belakang berderau halus yang cerah, sehingga mudah dikenali dan dibaca secara visual."]}]}